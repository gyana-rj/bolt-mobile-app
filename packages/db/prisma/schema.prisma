generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id         String        @id     @default(uuid())
  email      String        @unique
  createAt   DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Project {
  id          String        @id     @default(uuid())
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

