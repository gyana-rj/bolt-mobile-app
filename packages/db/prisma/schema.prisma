generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id         String        @id     @default(uuid())
  email      String        @unique
  createAt   DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Project {
  id          String        @id     @default(uuid())
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  prompt      Prompt[]
  userId      String
}

model Prompt {
  id          String          @id      @default(uuid())
  content     String
  type        PromptType
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
}

enum PromptType{
  USER
  SYSTEM
}