generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id        String   @id @default(uuid())
  email     String   @unique
  createAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  prompt      Prompt[]
  userId      String
  action      Action[]
}

model Prompt {
  id        String     @id @default(uuid())
  content   String
  type      PromptType
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
}

model Action {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  content   String
}

enum PromptType {
  USER
  SYSTEM
}
